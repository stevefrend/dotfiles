export LANG="en_US.UTF-8"

# === TERM fallback ===
# If current TERM has no terminfo entry (e.g. xterm-ghostty on Debian),
# fall back to xterm-256color to prevent keyboard weirdness.
if ! infocmp "$TERM" &>/dev/null 2>&1; then
  TERM=xterm-256color
fi

# === Machine-specific ===
# $LOCATION variable set in ~/.zshenv
{% if location is defined and location == "work" %}
echo "Loading work config from ~/.zshwork"
source ~/.zshwork
{% endif %}

# === Oh My Zsh ===
HYPHEN_INSENSITIVE="true"
DISABLE_AUTO_TITLE="true"
DEFAULT_USER="$USER"
plugins=(git)

# === FZF ===
[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh

# === NVM ===
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# === Colors for man pages ===
export LESS_TERMCAP_mb=$'\e[1;35m'
export LESS_TERMCAP_md=$'\e[1;35m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_so=$'\e[01;44m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_us=$'\e[1;4;32m'

# === Aliases ===
alias ls='eza'
alias k='clear'
alias find_node='lsof -i :9000'
alias kill_node='kill -9'
alias session='{{ dotfiles_dir }}/.scripts/tmuxFrontendInitializer.sh'
alias python='python3'

# === History ===
HISTFILE=$HOME/.zhistory
SAVEHIST=500
HISTSIZE=499
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

# === Zoxide ===
eval "$(zoxide init --cmd cd zsh)"
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=252"

# === Pyenv ===
export PYENV_ROOT="$HOME/.pyenv"
if [[ -d $PYENV_ROOT/bin ]]; then
  export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init - zsh)"
fi

# === Oh My Zsh ===
export ZSH="$HOME/.oh-my-zsh"
source $ZSH/oh-my-zsh.sh

# === Zsh custom plugins (sourced after oh-my-zsh) ===
{% if ansible_system == "Darwin" %}
source {{ brew_prefix }}/share/zsh-autosuggestions/zsh-autosuggestions.zsh
{% else %}
source {{ ansible_env.HOME }}/.oh-my-zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
{% endif %}

# === Zsh syntax highlighting (must be last of all) ===
{% if ansible_system == "Darwin" %}
source {{ brew_prefix }}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{% else %}
source {{ ansible_env.HOME }}/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{% endif %}

# === SDKMAN ===
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# === Local bin ===
export PATH="$HOME/.local/bin:$PATH"
