# Ported from .wezterm.lua

theme = Rose Pine Moon

font-family = JetBrainsMono Nerd Font
font-size = 15

# WezTerm forced TERM=xterm-256color; mirror it so remote terminfo
# (and tmux) don't trip over ghostty's default xterm-ghostty.
term = xterm-256color

background-opacity = 0.8
background-blur-radius = 45

window-padding-x = 20
window-padding-y = 20
window-padding-balance = true

# cmd++ to grow the font is a ghostty default, so no explicit keybind needed.
